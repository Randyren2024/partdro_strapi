# Server-side only: the browser always talks to the Nuxt BFF, never to Strapi,
# so an in-container address is fine here.
NUXT_PUBLIC_STRAPI_URL=http://cms:1337
# Read-only token for the public BFF.
NUXT_STRAPI_TOKEN=replace-me
# Full Access token, server-side only.
NUXT_STRAPI_FULL_TOKEN=replace-me

NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_SERVICE_KEY=replace-me