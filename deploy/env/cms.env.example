HOST=0.0.0.0
PORT=1337

APP_KEYS=replace-me
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@host:5432/strapi
DATABASE_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=product-media

# In-container address of the cms service.
STRAPI_URL=http://cms:1337
# Full Access token (write). Never expose this to the browser.
STRAPI_TOKEN=replace-me