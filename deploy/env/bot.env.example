FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=replace-me

# Ingest model (opencode agent + python pipeline)
AI_API_KEY=sk-or-v1-replace-me
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=baidu/ernie-5.5-flash-preview:free

# Chat model (merged LLM bot). Falls back to AI_* when unset.
LLM_API_KEY=sk-or-v1-replace-me
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=baidu/ernie-5.5-flash-preview:free

# Optional MCP server (Streamable HTTP) that gives chat the feishu_* tools.
MCP_URL=
MCP_API_KEY=

STRAPI_URL=http://cms:1337
STRAPI_TOKEN=replace-me

PARTDRO_SITE_URL=http://169.58.136.188

# Agent budget: the opencode run occasionally stalls during init, so it is
# retried once before the fixed pipeline takes over.
# Path to the opencode binary; defaults to PATH lookup.
OPENCODE_BIN=
AGENT_TIMEOUT=600
AGENT_RETRIES=1
BOT_TIMEOUT=1800