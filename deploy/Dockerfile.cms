FROM node:22-bookworm AS build
WORKDIR /app
COPY cms/package.json cms/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY cms/ ./
RUN NODE_OPTIONS=--max-old-space-size=3072 npm run build

FROM node:22-bookworm
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
EXPOSE 1337
CMD ["npm", "run", "start"]