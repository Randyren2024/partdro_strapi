{
  "collectionName": "components_shared_meta_socials",
  "info": {
    "displayName": "metaSocial",
    "icon": "project-diagram",
    "description": "Per-network social sharing metadata (Facebook / Twitter)"
  },
  "options": {},
  "attributes": {
    "socialNetwork": {
      "type": "enumeration",
      "enum": [
        "Facebook",
        "Twitter"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 65,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": false
    }
  }
}