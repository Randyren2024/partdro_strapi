{
  "collectionName": "components_shared_feature_items",
  "info": {
    "displayName": "FeatureItem",
    "description": "titled item with optional spec chip and image; spec also stores payload code / deployment category"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "spec": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
