# Public Strapi origin (safe to expose; used to build media URLs in components).
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API token (read-only is enough). Settings -> API Tokens in Strapi admin.
NUXT_STRAPI_TOKEN=
# Full-access token: server-only, required for ingest writes (POST/PUT).
NUXT_STRAPI_FULL_TOKEN=

# Supabase (server-only) - fallback snapshot store used when Strapi is unreachable.
# Copy NUXT_SUPABASE_URL and NUXT_SUPABASE_SERVICE_KEY from cms/.env
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY there).
# The service role key bypasses RLS; keep it server-side, never under public runtimeConfig.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=